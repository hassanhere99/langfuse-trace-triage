# Copy this file to .env and fill it in. .env is gitignored.
# The demo scripts read Langfuse settings only from .env, never from your shell.

# --- Langfuse -------------------------------------------------------------------
# Project settings > API keys in Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud: https://cloud.langfuse.com   US cloud: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Model endpoint for the demo agent and the promptfoo tests -----------------
# Any OpenAI-compatible chat completions endpoint with tool calling works.
# Set all three values. Keep one block uncommented and leave the others commented out.

# Ollama, running locally (free). Install Ollama, run `ollama serve`, then
# `ollama pull <model>` for a model tagged "tools" in the Ollama library.
# Ollama ignores the API key, but the client needs some value.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
DEMO_MODEL=llama3.2:3b

# DeepSeek (paid key). UNTESTED with this repo.
# Check DeepSeek's current model list for the model ID.
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=<your-deepseek-key>
# DEMO_MODEL=<model-id>

# OpenAI (paid key). UNTESTED with this repo.
# Check OpenAI's current model list for a model that supports tool calling in Chat Completions.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=<your-openai-key>
# DEMO_MODEL=<model-id>
